{
  "name": "@acrux-education/chat-widget",
  "version": "0.1.12",
  "description": "Acrux Education embeddable chat widget",
  "type": "module",
  "main": "dist/acrux-chat.es.js",
  "module": "dist/acrux-chat.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/acrux-chat.es.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "dev": "vite",
    "build": "npm run build:esm && npm run build:iife",
    "build:esm": "vite build",
    "build:iife": "vite build --config vite.config.iife.ts && node scripts/sri-manifest.mjs",
    "verify:release": "node scripts/sri-manifest.mjs --verify",
    "lint": "eslint src/",
    "preview": "vite preview",
    "test": "vitest",
    "test:integrity": "node --test scripts/sri-manifest.node-test.mjs",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "rolldown": "1.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.0"
  }
}
