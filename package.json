{
  "name": "@acrux-education/chat-widget",
  "version": "0.1.7",
  "description": "Acrux Education embeddable chat widget",
  "type": "module",
  "main": "dist/acrux-chat.es.js",
  "module": "dist/acrux-chat.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/acrux-chat.es.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "dev": "vite",
    "build": "npm run build:esm && npm run build:iife",
    "build:esm": "vite build",
    "build:iife": "vite build --config vite.config.iife.ts",
    "lint": "eslint src/",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "react": "^19.2.4",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  }
}
