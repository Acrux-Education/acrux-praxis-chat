{
  "name": "@acrux-education/chat-widget",
  "version": "0.1.14",
  "description": "Acrux Education embeddable chat widget",
  "type": "module",
  "main": "dist/acrux-chat.es.js",
  "module": "dist/acrux-chat.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/acrux-chat.es.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "npm run build",
    "dev": "vite",
    "build": "npm run build:esm && npm run build:iife",
    "build:esm": "vite build",
    "build:iife": "vite build --config vite.config.iife.ts && node scripts/sri-manifest.mjs",
    "verify:release": "node scripts/sri-manifest.mjs --verify",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "type-check": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:integrity": "node --test scripts/sri-manifest.node-test.mjs",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip --no-exit-code"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "knip": "6.36.0",
    "oxlint": "^1.83.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
